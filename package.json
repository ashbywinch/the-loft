{
  "name": "the-loft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Loft — family history museum (static web app; no build step). Runtime deps: none by design (TECH-SPEC §2).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
