    "format": "prettier --write app"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-istanbul": "4.1.11",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.9.0",
    "happy-dom": "20.11.1",
    "prettier": "3.9.6",
    "vitest": "4.1.10"
  }
}
