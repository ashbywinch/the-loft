# No environment variables are required for browsing.
# The capture server (tools/loft_server.py) resolves its AI key at runtime:
# LOFT_AI_KEY, else OPENCODE_API_KEY, else opencode's auth.json. Endpoint and
# model are overridable. Values stay blank in this file — real secrets live in
# the shell environment (docs/coding-standards.md).
LOFT_AI_KEY=
# the capture server sends the narrator's story text to this model
# endpoint (PRD §18.3: keep it to a model you trust — a local one works)
LOFT_AI_BASE_URL=
LOFT_AI_MODEL=
LOFT_ARCHIVE=

# Google sign-in (2026-08-06) — the identity seam. The OAuth client's
# redirect URIs must include http://<LAN-IP>:8000/api/auth/callback
# (houses registers the LAN IP the same way). Values are blank by
# definition — real secrets live in the shell environment (AGENTS.md).
THE_LOFT_GOOGLE_WEB_CLIENT_ID=
THE_LOFT_GOOGLE_WEB_CLIENT_SECRET=
THE_LOFT_SESSION_SECRET=
THE_LOFT_PUBLIC_URL=http://localhost:8000
