{
  "name": "the-loft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Loft — family history museum (static web app; vanilla ES modules with a generated boot bundle). Runtime deps: none by design (TECH-SPEC §2).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild app/entry.js --bundle --format=esm --splitting --minify --outdir=app/dist --entry-names=boot --chunk-names='chunk-[hash]'",
    "lint": "eslint app",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "format": "prettier --write app"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-istanbul": "5.0.2",
    "esbuild": "^0.28.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "happy-dom": "20.14.5",
    "prettier": "3.9.9",
    "vitest": "5.0.2"
  }
}
